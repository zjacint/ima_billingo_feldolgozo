# PostgreSQL (Cloud SQL) connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/billingo_ima_admin?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (Workspace)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Bejelentkezés csak erről a Google Workspace domainről (+ az admin által
# whitelistelt OtpAllowedEmail címekről, email-OTP-vel)
ALLOWED_GOOGLE_WORKSPACE_DOMAIN="example.com"

# Email-OTP küldéshez SMTP kapcsolat (pl. Google Workspace SMTP relay vagy
# tranzakciós email szolgáltató — ld. docs/tervezes.md 12. Nyitott kérdések)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="IMA admin <no-reply@example.com>"

# IMA API host-ok — NEM cégenkéntiek, ld. docs/tervezes.md 2.2 fejezet.
# Csak akkor kell felülírni, ha IMA teszt/staging környezetet ad.
IMA_SUBMIT_API_BASE_URL="https://imaapi.imaerp.hu"
IMA_CLIENT_API_BASE_URL="https://clientapi.imaerp.hu"

# Billingo API base URL — cégenkénti API-kulcs a Company rekordban van,
# nem itt (ld. docs/tervezes.md 4. fejezet).
BILLINGO_API_BASE_URL="https://api.billingo.hu/v3"
