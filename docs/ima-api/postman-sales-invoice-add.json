    {
      "name": "01. Vevoi szamla beszurasa / Add sales invoice (existing partner)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "user",
            "value": "{{user}}",
            "type": "text"
          },
          {
            "key": "company",
            "value": "{{company}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"header_data\": [\n    {\n      \"invoice_external_id\": \"{{invoiceExternalId}}\",\n      \"partner_id\": {{partnerId}},\n      \"posting_date\": \"{{postingDate}}\",\n      \"doc_date\": \"{{postingDate}}\",\n      \"vat_date\": \"{{postingDate}}\",\n      \"due_date\": \"{{dueDate}}\",\n      \"invoice_type\": \"invoice\",\n      \"currency\": \"HUF\",\n      \"gross_amount\": 127000,\n      \"payment_method\": \"Atutalas\",\n      \"invoice_source\": \"{{invoiceSource}}\",\n      \"external_accounting_mode\": \"{{externalAccountingMode}}\",\n      \"external_comments\": [\n        {\n          \"external_source\": \"cadren\",\n          \"external_id\": \"{{externalCommentId}}\",\n          \"user_name\": \"Kovacs Anna\",\n          \"date_added\": \"2026-06-30T09:15:00+02:00\",\n          \"comment\": \"Ugyfel altal rogzitett megjegyzes.\"\n        },\n        {\n          \"external_id\": \"CAD-COM-002\",\n          \"user_name\": \"Nexol Bot\",\n          \"date_added\": \"20260630\",\n          \"comment\": \"Masodik kulso megjegyzes.\"\n        }\n      ],\n      \"lines_data\": [\n        {\n          \"unit_cost_type\": \"netto\",\n          \"line_type\": \"invoice\",\n          \"description\": \"Eves elofizetes\",\n          \"quantity\": 1,\n          \"line_unit_cost\": 100000,\n          \"vat_code\": \"{{vatCode}}\"\n        }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/invoices/sales/add/{{apiKey}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "invoices",
            "sales",
            "add",
            "{{apiKey}}"
          ]
        },
        "description": "Meglevo partner_id-vel kuld egy egyszeru HUF-os vevoi szamlat. This is the smallest practical success-case payload."
      },
      "response": []
    },
    {
